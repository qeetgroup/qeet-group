# qeet.in — environment
#
# None of these are required for local development: Resend and Plausible no-op
# without their keys, and the origin falls back to https://qeet.in.
#   cp .env.example .env

# --- Contact form + newsletter (Resend) ------------------------------------
# Without RESEND_API_KEY the contact form validates and reports success without
# sending. Keys: https://resend.com/api-keys
RESEND_API_KEY=
# Newsletter signups are added to this Resend audience.
RESEND_AUDIENCE_ID=
# From/To headers on contact emails. FROM must be on a verified Resend domain.
CONTACT_FROM=
CONTACT_TO=

# --- Analytics (Plausible, cookie-less) ------------------------------------
# Set to the site domain to load the script. Leave empty to disable entirely.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Origin ----------------------------------------------------------------
# Drives metadataBase, canonicals, og:url, the sitemap and robots. Set this on
# preview and staging deploys so they do not emit production canonicals.
#   preview: https://<branch>.preview.qeet.in
#   staging: https://staging.qeet.in
NEXT_PUBLIC_SITE_ORIGIN=
